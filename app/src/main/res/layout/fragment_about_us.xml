<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingBottom="56dp">

        <!-- Title -->
        <TextView
            android:text="About Us"
            android:textColor="#2E86DE"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Repeatable Team Member Card -->
        <!-- Team Member 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#F2F2F2"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="4dp"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/syazwan"
                android:contentDescription="Syazwan photo"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Muhammad Syazwan Syahmi Bin Mat Zaidi\n(2024927503)"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- Team Member 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#F2F2F2"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="4dp"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/wan"
                android:contentDescription="Wan photo"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wan Muhammad Zulhaziq Bin Wan Husni\n(2024779375)"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- Team Member 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#F2F2F2"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="4dp"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/aiman"
                android:contentDescription="Aiman photo"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aiman Hafizuddin Bin Mohd Marman\n(2024568775)"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- Team Member 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#F2F2F2"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="4dp"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/fathan"
                android:contentDescription="Fathan photo"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Muhammad Fathan Bishri Bin Mohamad Sofuan\n(2024766965)"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textColor="#333333" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>